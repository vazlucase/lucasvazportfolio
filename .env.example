VITE_CONTACT_EMAIL=lucas@email.com

# Somente no servidor. Nunca use prefixo VITE_ nestas variáveis.
# Gere com npm run setup:admin (local) ou npm run setup:production (Vercel).
# A senha original fica em secrets/, nunca no código ou no GitHub.
ANALYTICS_ADMIN_PASSWORD_HASH=
ANALYTICS_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: separa os dados de diferentes sites no mesmo banco.
ANALYTICS_KEY_PREFIX=lucasvaz:analytics:v1
